# Copy to `.env.local` and fill in. `.env.local` is git-ignored; values here
# override `.env` locally. Vite inlines VITE_* at BUILD time, so these are
# public by design — never put a secret in a VITE_ variable.

# Environment
VITE_NODE_ENV=development

# Public base path the site is served from. Mirrors how it will be hosted so
# local dev exercises the same URL layout as production:
#   /ysr-system-front/  -> GitHub Pages project site
#   /                   -> custom domain (panel.rohanian-ysr.ir)
# With the default, `npm run dev` serves the app at
# http://localhost:4000/ysr-system-front/ — not http://localhost:4000/.
VITE_BASE_PATH=/ysr-system-front/

# API Configuration
# Absolute origin of the backend. Leave empty to use same-origin requests
# (only correct when the API is proxied on the same host). Unset/empty in a
# production build falls back to the app origin, not to localhost:3000.
VITE_API_BASE_URL=http://localhost:3000

# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
# Must match the backend GOOGLE_CLIENT_ID, and the origin this app is served
# from must be listed under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
