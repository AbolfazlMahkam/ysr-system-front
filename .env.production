# Production build configuration — loaded automatically by `vite build`.
#
# Vite inlines VITE_* values into the bundle at BUILD time, so changing any of
# these requires a rebuild. They are public by design (they are readable by
# anyone who loads the site); never put a secret here.
#
# All VITE_* keys are also read by vite.config.ts via loadEnv, and any
# VITE_* variable set in the environment (e.g. by the Pages workflow) takes
# precedence over this file.

# Public base path the site is served from. MUST match where it is hosted:
#   /ysr-system-front/  -> GitHub Pages project site
#   /                   -> custom domain (panel.rohanian-ysr.ir)
VITE_BASE_PATH=/ysr-system-front/

# Backend origin. Requests are sent to this host, not to the page origin, so it
# must be absolute here.
VITE_API_BASE_URL=https://api.rohanian-ysr.ir

# Google OAuth client id. Public by design (it is embedded in the JS bundle).
# Get from: https://console.cloud.google.com/apis/credentials
# Every origin the app is served from must be listed under "Authorized
# JavaScript origins" in the Google Cloud console.
VITE_GOOGLE_CLIENT_ID=
