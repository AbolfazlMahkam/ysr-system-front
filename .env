# Local/default build configuration.
#
# Vite inlines VITE_* values at BUILD time, so these are public by design — never
# put a secret in a VITE_ variable. For local overrides use `.env.local`
# (git-ignored), which takes precedence over this file.
#
# `.env.production` overrides both values below for `npm run build`, and
# `.env.example` documents them for a fresh clone.

# Backend origin. The app sends every API request to this host rather than to the
# page origin, so it must be absolute. Point local dev at the same API as
# production (https://api.rohanian-ysr.ir) so `npm run dev` exercises the real
# endpoints instead of a localhost stub that may not be running.
#
# Set VITE_API_BASE_URL= (empty) to target the page origin instead — that is only
# correct when the API is served from the same host, e.g. behind the nginx in
# nginx.conf that proxies /uploads.
VITE_API_BASE_URL=https://api.rohanian-ysr.ir
